# App
APP_ENV=development
AUTH_MODE=none
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# LLM
LLM_PROVIDER=mock            # ollama | vllm | mock
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=http://localhost:8001/v1
MODEL_NAME=qwen3:8b
LLM_NUM_CTX=16384
LLM_TIMEOUT_S=120

# Database
# Default Docker PostgreSQL:
DATABASE_URL=postgresql+asyncpg://openresearch:openresearch@localhost:5432/openresearch
# Or for zero-docker local dev: sqlite+aiosqlite:///./openresearch.db

# External APIs
GITHUB_TOKEN=
SEMANTIC_SCHOLAR_API_KEY=
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
HF_TOKEN=

# Research budgets
MAX_CRITIC_CYCLES=2
MAX_TOOL_CALLS=60
MAX_SOURCES=60
MAX_DEEP_READ_SOURCES=25
RUN_TIMEOUT_S=900

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
